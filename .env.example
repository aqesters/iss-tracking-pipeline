# =============================================================================
# IoT Pipeline — Environment Configuration
# Copy this file to `.env` and fill in real values before running.
# `.env` is git-ignored — never commit real credentials or tokens.
# =============================================================================

# ---------- General ----------
# Used to namespace container names / volumes when running multiple client
# stacks on the same host (e.g. Portainer, or a shared VM).
COMPOSE_PROJECT_NAME=iiot-clientname

# ---------- InfluxDB 2.x ----------
# Initial admin user created on first boot (setup mode). Change the password.
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=change-me-strong-password
INFLUXDB_INIT_ORG=acme-manufacturing
INFLUXDB_INIT_BUCKET=plant-floor
# How long raw data is retained before InfluxDB drops it, e.g. 30d, 90d, 0 (infinite)
INFLUXDB_INIT_RETENTION=90d
# Fixed admin token — generate with `openssl rand -hex 32`. Fixing this (rather
# than letting InfluxDB generate one) is what lets Node-RED/Grafana connect
# with a known value on every fresh deploy.
INFLUXDB_INIT_ADMIN_TOKEN=replace-with-openssl-rand-hex-32

# Values below are what Node-RED and Grafana actually use to connect.
# In a single-stack deployment these mirror the INIT_* values above.
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=acme-manufacturing
INFLUXDB_BUCKET=plant-floor
INFLUXDB_TOKEN=replace-with-openssl-rand-hex-32

# ---------- Node-RED ----------
# Encrypts credentials stored in node-red/data/flows_cred.json.
# Generate with `openssl rand -hex 32`. Changing this after first run
# invalidates any saved node credentials.
NODE_RED_CREDENTIAL_SECRET=replace-with-openssl-rand-hex-32
# Exposed port on the host
NODE_RED_PORT=1880
# Set to "true" once you've configured adminAuth in settings.js for a client
# deployment. Left disabled by default for local development.
NODE_RED_ENABLE_AUTH=false

# ---------- Grafana ----------
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-password
# Allow/disallow anonymous viewer access (useful for a lobby TV dashboard;
# leave false for anything client-facing with sensitive data)
GRAFANA_ALLOW_ANONYMOUS=false
