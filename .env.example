# =============================================================================
# Environment Configuration
# Copy this file to `.env` and fill in real values before running.
# `.env` is git-ignored — never commit real credentials or tokens.
# =============================================================================

# ---------- General ----------
# Prefix for container and volume names. Don't change this after first run:
# a new name points the stack at new, empty volumes.
COMPOSE_PROJECT_NAME=iss-tracker

# ---------- InfluxDB 2.x ----------
# Initial admin user created on first boot (setup mode). Password can be changed later.
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=default-password
INFLUXDB_INIT_ORG=iss_data
INFLUXDB_INIT_BUCKET=iss_position_data
# How long raw data is retained before InfluxDB drops it, e.g. 30d, 90d, 0 (infinite)
INFLUXDB_INIT_RETENTION=90d
# Fixed admin token — generate with `openssl rand -hex 32`. Fixing this (rather
# than letting InfluxDB generate one) is what lets Node-RED/Grafana connect
# with a known value on every fresh deploy.
INFLUXDB_INIT_ADMIN_TOKEN=replace-with-openssl-rand-hex-32

# Values Node-RED and Grafana use to connect. Each must match its INIT_* value above.
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=iss_data
INFLUXDB_BUCKET=iss_position_data
INFLUXDB_TOKEN=replace-with-openssl-rand-hex-32

# ---------- Node-RED ----------
# Encrypts credentials stored in node-red/data/flows_cred.json.
# Generate with `openssl rand -hex 32`. Changing this after first run
# invalidates any saved node credentials.
NODE_RED_CREDENTIAL_SECRET=replace-with-openssl-rand-hex-32
# Exposed port on the host
NODE_RED_PORT=1880
# Set to "true" if the Node-RED editor is reachable outside your LAN/VPN,
# after configuring adminAuth in settings.js.
NODE_RED_ENABLE_AUTH=false

# ---------- Grafana ----------
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=default-password
# "true" lets anyone on the network view dashboards without logging in
# (useful for a wall display).
GRAFANA_ALLOW_ANONYMOUS=false
# Grafana service account token used by gcx for `make sync-grafana` / `make restore-grafana`
GRAFANA_SA_TOKEN=replace-with-service-account-token
