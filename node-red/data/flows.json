    {
        "id": "86a52c3906d4525c",
        "type": "function",
        "z": "4a65d366b52695a9",
        "g": "991d4a908246e024",
        "name": "Parse ISS tracking details",
        "func": "const body = msg.payload;\nif (!body || typeof body.latitude !== \"number\" || typeof body.longitude !== \"number\") {\n    node.warn(\"wheretheiss.at API returned an unexpected/missing payload\");\n    return null;\n}\nmsg.payload = [\n    {\n        latitude: body.latitude,\n        longitude: body.longitude,\n        altitude_km: body.altitude,\n        velocity_kmh: body.velocity,\n        footprint_km: body.footprint,\n        solar_lat: body.solar_lat,\n        solar_lon: body.solar_lon\n    },\n    { source: \"wheretheiss\", visibility: body.visibility }\n];\nmsg.measurement = \"iss_track\";\nreturn msg;",
