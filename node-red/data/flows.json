    {
        "id": "6f756a3fbdeeeac0",
        "type": "function",
        "z": "4a65d366b52695a9",
        "g": "d2021cb439e8de68",
        "name": "Parse crew count",
        "func": "const body = msg.payload;\nif (!body || body.message !== \"success\" || !Array.isArray(body.people)) {\n    node.warn(\"People in Space API returned non-success or malformed payload\");\n    return null;\n}\nconst issCrew = body.people.filter(p => p.craft === \"ISS\");\nmsg.payload = [\n    {\n        crew_count: issCrew.length,\n        total_people_in_space: body.number\n    },\n    { source: \"open_notify\" }\n];\nmsg.measurement = \"iss_crew\";\nreturn msg;",
