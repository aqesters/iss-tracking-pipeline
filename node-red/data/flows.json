    {
        "id": "cd1f2f96a2fc31f8",
        "type": "function",
        "z": "4a65d366b52695a9",
        "g": "27cfac4033418569",
        "name": "Parse ISS position",
        "func": "const body = msg.payload;\nif (!body || body.message !== \"success\") {\n    node.warn(\"ISS Now API returned non-success\");\n    return null;\n}\nmsg.payload = [\n    {\n        latitude: parseFloat(body.iss_position.latitude),\n        longitude: parseFloat(body.iss_position.longitude)\n    },\n    { source: \"open_notify\" }\n];\nmsg.measurement = \"iss_position\";\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
